# .env.example — SatQuery AI
# Reference template only. Do NOT unconditionally overwrite an existing .env file.
# If .env already exists, preserve existing credentials/values and add only missing configuration fields. Never commit .env.
# All secrets remain backend-only. MapTiler key is public but MUST be origin-restricted.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development          # "development" | "production"
                             # production: rejects dev-identity bypass, enforces TLS
DATA_MODE=online             # "online" | "test"
                             # test: enables fixture mode; injects "TEST DATA" banner

# ---------------------------------------------------------------------------
# Authentication (single-operator; ADR-012)
# ---------------------------------------------------------------------------
OPERATOR_USERNAME=analyst
OPERATOR_PASSWORD=changeme_strong_password
# Secret key for session/CSRF tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_PASSWORD@localhost:5432/satquery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_PASSWORD
POSTGRES_DB=satquery

# ---------------------------------------------------------------------------
# Redis & Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# In production: restrict to your actual domain(s)

# ---------------------------------------------------------------------------
# Groq LLM (optional — pipeline works without it; ADR-013)
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY
# Verify the exact model ID at https://console.groq.com/docs/models
GROQ_MODEL=llama3-8b-8192

# ---------------------------------------------------------------------------
# Copernicus Data Space (ADR-009)
# Catalog: STAC API; Download: OData; Auth: Sentinel Hub OAuth2
# Register at https://dataspace.copernicus.eu/
# ---------------------------------------------------------------------------
COPERNICUS_CLIENT_ID=REPLACE_WITH_CLIENT_ID
COPERNICUS_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
COPERNICUS_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
# Do NOT mix Sentinel Hub Process API credentials here; those are a separate service.

# ---------------------------------------------------------------------------
# MapTiler (public key — browser requests allowed; MUST set HTTP referrer restrictions)
# ---------------------------------------------------------------------------
VITE_MAPTILER_API_KEY=REPLACE_WITH_ORIGIN_RESTRICTED_KEY
# Configure allowed origins at https://cloud.maptiler.com/account/keys/

# ---------------------------------------------------------------------------
# HuggingFace (for model downloads)
# ---------------------------------------------------------------------------
HUGGINGFACE_TOKEN=hf_REPLACE_WITH_YOUR_HF_TOKEN

# ---------------------------------------------------------------------------
# ML Models
# ---------------------------------------------------------------------------
REMOTECLIP_MODEL_PATH=./models/remoteclip/RemoteCLIP-ViT-L-14.pt
REMOTECLIP_SHA256=REPLACE_AFTER_DOWNLOAD
REMOTECLIP_EMBEDDING_DIM=768   # confirm from checkpoint

CHANGEFORMER_CHECKPOINT_PATH=./models/changeformer/ChangeFormer_LEVIR.pth
CHANGEFORMER_SHA256=REPLACE_AFTER_DOWNLOAD
# Training dataset of checkpoint (important for domain-gap disclosure)
CHANGEFORMER_TRAINING_DATASET=LEVIR-CD

# ---------------------------------------------------------------------------
# Compute
# ---------------------------------------------------------------------------
DEVICE=cpu                   # "cuda" | "cpu" — doctor.py reports what is available
BATCH_SIZE=8                 # reduce to 2-4 on low-memory machines
WORKER_CONCURRENCY=1         # number of Celery workers; 1 = low-resource profile
CPU_THREADS=4                # torch.set_num_threads

# ---------------------------------------------------------------------------
# Storage paths and limits
# ---------------------------------------------------------------------------
DATA_PATH=./data
CACHE_PATH=./data/cache
INDEX_PATH=./indexes
REPORT_PATH=./reports
FREE_DISK_RESERVE_GB=5       # minimum free disk required to start ingestion
STORAGE_BUDGET_GB=50         # total budget; eviction rules protect referenced evidence

# ---------------------------------------------------------------------------
# Tile / grid settings
# ---------------------------------------------------------------------------
TILE_SIZE=256
TOP_K=20
MAX_RESULTS=100

# ---------------------------------------------------------------------------
# Change detection thresholds (ADR-006)
# Units are explicit: m² and pixels
# These are unevaluated engineering defaults, NOT detection guarantees.
# At a 10 m analysis grid: 1 pixel = 100 m²
# ---------------------------------------------------------------------------
CHANGE_THRESHOLD=0.55
MIN_CHANGE_AREA_M2=900       # = 9 pixels × 100 m²/px at 10 m grid
MIN_CHANGE_PIXELS=9          # 3×3 connected minimum component

# ---------------------------------------------------------------------------
# QC / confidence scoring (ADR-013)
# ---------------------------------------------------------------------------
QC_WEIGHTS_VERSION=v1.0
# JSON object mapping factor names to weights; must sum <= 1.0
# Missing/unavailable factors contribute 0 weight, never assumed-perfect
CONFIDENCE_WEIGHTS={"valid_ratio":0.20,"registration_quality":0.20,"cloud_quality":0.15,"season_similarity":0.15,"temporal_consistency":0.20,"model_score":0.10}

# ---------------------------------------------------------------------------
# AOI and job limits
# ---------------------------------------------------------------------------
MAX_AOI_AREA_KM2=10000       # maximum AOI area
MAX_AOI_VERTICES=1000        # maximum polygon vertices
MAX_DATE_SPAN_DAYS=3650      # maximum date range (~10 years)
MAX_SCENES_PER_JOB=50        # maximum scenes in one ingestion job
MAX_RASTER_PIXELS_PER_JOB=1000000000  # 1 billion pixels
MAX_UPLOAD_BYTES=52428800    # 50 MB
MAX_DECODED_IMAGE_PIXELS=268435456    # 256 MP decompression guard

# ---------------------------------------------------------------------------
# Timeouts and retries
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_S=30
RETRY_LIMIT=3
RETRY_BACKOFF_S=2.0
JOB_TIME_LIMIT_S=3600        # 1 hour
EVENT_RETENTION_DAYS=30
